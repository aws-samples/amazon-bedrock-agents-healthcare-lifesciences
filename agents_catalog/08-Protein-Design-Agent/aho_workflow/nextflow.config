params {
    aws_region = "us-west-2"
    // Provided at run time via the esm_model_files workflow parameter
    // (the trigger tool always passes it). No hardcoded bucket default.
    esm_model_files = null
    onehotcnn_model_files = null
    output_type = 'all'
    parallel_chains = 10
    n_steps = 100
    max_mutations = 15
}